{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@/components": [
        "stories/components/index.ts"
      ],
      "@/components/*": [
        "stories/components/*"
      ]
    }
  },
  "include": [
    "stories/**/*",
    "vite.config.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
